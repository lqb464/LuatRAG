# Server-side only. Never expose this value with a NEXT_PUBLIC_ prefix.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3018
# Docker host ports; internal container ports remain 3000 / 8000.
WEB_PORT=3018
PORT=8018
LUATRAG_DATA_DIR=./data/runtime
# Required in production (at least 32 random bytes), shared only with the BFF.
LUATRAG_BFF_SECRET=
GEMINI_API_KEY=

# Optional server-side model override. Only stable Flash-Lite models are allowed.
GEMINI_MODEL=gemini-3.1-flash-lite
